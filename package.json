{
  "name": "dsh-plugin-session-messaging",
  "version": "0.1.0",
  "description": "DSH bundle plugin: cross-session addressing and messaging tools (list_session_agents, send_session_message, review_session_messages), official subagent/team routing, inbound accept/hold/refuse approval, and a local bus for shell scripts",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/dsh-plugin-session-messaging.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent",
    "session",
    "messaging",
    "inter-agent"
  ],
  "author": "DSH contributors",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
