{
  "name": "session-messaging",
  "version": "0.1.0",
  "description": "DSH (DeepSeek Harness) plugin for cross-session messaging: address, message and wake AI agent sessions, approve inbound messages, and send from bash/pwsh scripts. Includes a separately toggleable session-creation component.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./creation": {
      "types": "./lib/types/creation.d.ts",
      "default": "./lib/creation.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./creation/locale/*.json": "./locale/creation/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/**/*.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evil-Wideplain/session-messaging.git"
  },
  "homepage": "https://github.com/Evil-Wideplain/session-messaging#readme",
  "bugs": {
    "url": "https://github.com/Evil-Wideplain/session-messaging/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "ai-agents",
    "multi-agent",
    "agent-teams",
    "agent-to-agent",
    "agent-orchestration",
    "cross-session",
    "session-messaging",
    "inter-agent-communication",
    "session-management",
    "cordis",
    "local-bus",
    "typescript",
    "nodejs"
  ],
  "author": "DSH contributors",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
